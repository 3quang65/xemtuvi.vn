#!/bin/sh
# Chặn commit khi kiểm thử không đạt (quy ước: CLAUDE.md, mục Kỹ thuật).
# Cài một lần cho mỗi bản clone: git config core.hooksPath .githooks (npm install làm sẵn qua "prepare").

log=$(mktemp)
trap 'rm -f "$log"' EXIT

echo "pre-commit: chạy npm test..."
if ! npm test >"$log" 2>&1; then
  tail -n 60 "$log"
  echo "pre-commit: npm test KHÔNG đạt, commit bị chặn. Sửa rồi commit lại."
  exit 1
fi
echo "pre-commit: npm test đạt."
